# productos pesan megas (la de recepción, nueve).
*.xlsx
# Audios y transcripciones de las entrevistas del equipo: datos personales
flujo de work FF/
# Configuración local de MCP
.mcp.json
# Vercel
.vercel
usuarios-fresafit.txt

